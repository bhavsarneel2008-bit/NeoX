{
  "manifest_version": 3,
  "name": "CanaryTrap X",
  "version": "1.0",
  "description": "Educational cybersecurity prototype for security testing.",
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
